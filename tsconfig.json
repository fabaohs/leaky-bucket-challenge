{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "paths": {
    "@/*": ["./src/*"],
    "@middlewares/*": ["./src/middlewares/*"],
    "@utils/*": ["./src/utils/*"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
